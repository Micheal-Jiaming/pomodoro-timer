# Build output — regenerated by build_exe.ps1 (its PyInstaller work dir is
# %TEMP%\pomodorotimer-build, so only dist\ appears here).
# The exe is not versioned: it is rebuilt from the tracked source, and an old
# exe cannot perform the functions of a newer source revision anyway.
build/
dist/

